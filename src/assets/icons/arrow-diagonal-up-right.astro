---
interface Props {
	class?: string
}

// `...rest` passes the parent's scope attribute, so the parent can style this icon
const { class: className, ...rest } = Astro.props
---

<svg
	class={className}
	{...rest}
	viewBox="0 0 24 24"
	xmlns="http://www.w3.org/2000/svg"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<line x1="7" y1="17" x2="17" y2="7"></line>
	<polyline points="7 7 17 7 17 17"></polyline>
</svg>
