---
import '../styles/globals.scss'
import { person } from '@data/person.json'
import { links as socialLinks } from '@data/socials.json'

// Structured data so search engines know who the page is about (https://schema.org/Person)
const site = Astro.site ?? new URL('https://leireomadina.vercel.app')
// Always the production URL, so Vercel preview deployments aren't indexed as duplicates
const canonicalUrl = new URL(Astro.url.pathname, site).href
const ogImageUrl = new URL('/og-image.jpg', site).href
const pageTitle = `${person.name} | ${person.role}`
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: person.name,
	alternateName: person.alternateNames,
	jobTitle: person.role,
	url: site.href,
	image: ogImageUrl,
	worksFor: {
		'@type': 'Organization',
		name: person.employer.name,
		url: person.employer.url,
	},
	address: {
		'@type': 'PostalAddress',
		addressLocality: person.location.city,
		addressRegion: person.location.region,
		addressCountry: person.location.country,
	},
	sameAs: socialLinks.map(({ href }) => href),
}
---

<!doctype html>
<html lang="en">
	<head>
		<title>{pageTitle}</title>
		<meta charset="utf-8" />
		<meta
			name="description"
			content="Front-end developer with more than five years of experience specialized in UI development and design with JavaScript, Vue, CSS, SASS, and HTML."
		/>
		<meta name="author" content={person.name} />
		<meta
			name="google-site-verification"
			content="pY0598N-GQBYQtIQp7zFd4pXEPniEG2mEA6xpA8xSpI"
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:title" content={pageTitle} />
		<meta
			property="og:description"
			content="Front-end developer with more than five years of experience specialized in UI development and design."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content="Leire's Portfolio" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta
			name="twitter:description"
			content="Front-end developer with more than five years of experience specialized in UI development and design."
		/>
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<script
			type="application/ld+json"
			set:html={JSON.stringify(personSchema)}
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style lang="scss">
	html {
		scroll-behavior: smooth;
	}
	body {
		font-family: $font-body;
		font-size: fluid(24px, 32px, 680px, 1180px);

		@include tablet {
			padding: fluid(24px, 48px, 680px, 1180px);
		}

		@include desktop {
			font-size: clamp(2rem, 2vw, 2.5rem);
		}
	}
</style>
