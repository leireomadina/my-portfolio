---
import ArrowIcon from '@assets/icons/arrow-diagonal-up-right.astro'
import Link from './Link.astro'
import { links } from '@data/socials.json'
---

<nav class="socials-nav">
	<ul>
		{
			links.map(({ text, href, title, isExternalLink }) => (
				<li class="socials-nav__item">
					<Link
						href={href}
						title={title}
						isExternalLink={isExternalLink}
						class="socials-nav__link"
					>
						{text}
						<ArrowIcon />
					</Link>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.socials-nav__item {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.25rem;
		border-bottom: 2px solid var(--color-link);
	}

	/* The <a> and the icon are rendered by other components, so they need :global */
	.socials-nav__item :global(.socials-nav__link) {
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		text-decoration: none;
	}

	.socials-nav__item :global(svg.icon) {
		width: 48px;
		height: 48px;
	}
</style>
