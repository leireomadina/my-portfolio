---
import Link from '@components/Link.astro'
---

<div class="grid-container" id="about">
	<h2 class="visually-hidden">About</h2>
	<p class="intro intro--role role">
		Passionate about crafting user-focused experiences and driving strategy-led
		creative processes.
	</p>
	<p class="intro intro--job job">
		Currently working at <Link
			href="https://www.kaytek.es/"
			title="Visit Kaytek's website"
			isExternalLink
		>
			Kaytek
		</Link>, an innovative startup focused on smart factory solutions.
	</p>
</div>
<div class="grid-container">
	<div class="info info--experience">
		<h3 class="info__title">Years of experience</h3>
		<p class="info__content info__content--year">5+</p>
	</div>
	<div class="info info--expertise">
		<h3 class="info__title">Specialized in</h3>
		<ul class="info__list">
			<li class="info__content">
				Web <span class="info__content--highlighted">development.</span>
			</li>
			<li class="info__content">
				Software <span class="info__content--highlighted">engineering.</span>
			</li>
			<li class="info__content">
				UX/UI <span class="info__content--highlighted">design.</span>
			</li>
		</ul>
	</div>
</div>
<div class="grid-container">
	<p class="intro intro--context">
		Versatile and detail-oriented self-taught programmer with prior experience
		in the architecture, research and design sectors.
	</p>
	<p class="intro intro--goal">
		Motivated to work on a team focused on good practices, continuous learning,
		feedback-driven culture and transparency.
	</p>
</div>

<style lang="scss" scoped>
	.grid-container {
		@include desktop {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-auto-flow: dense;
			margin-top: 3rem;
		}
	}

	.intro {
		&--role,
		&--context {
			grid-column: 1/7;
		}

		&--job,
		&--goal {
			grid-column: 8/13;
		}
	}

	.info {
		&--experience {
			grid-column: 1/4;
			margin-top: fluid(48px, 0px, 320px, 680px);
		}

		&--expertise {
			grid-column: 5/12;
		}

		&__title {
			margin-top: 2rem;
			margin-bottom: 0;
			font-size: fluid(24px, 32px, 680px, 1180px);
			font-family: $font-body;

			// Titles sit side by side in the desktop grid, so they line up at the top
			@include desktop {
				margin-top: 0;
			}
		}

		&__list {
			margin: 0 0 3rem 0;
		}

		&__content {
			margin: 0;
			font-family: $font-title;
			font-size: fluid(25.6px, 80px);
			color: $color-pink-dark;

			&--highlighted {
				font-family: $font-title-italic;
			}

			&--year {
				font-family: $font-body;
			}
		}
	}
</style>
