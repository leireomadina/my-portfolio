---
import Link from '@components/Link.astro'
import { person } from '@data/person.json'

const { name, url, description } = person.employer
const employerLink = {
	href: url,
	title: `Visit ${name}'s website`,
	isExternalLink: true,
}
---

<div class="about__grid" id="about">
	<h2 class="visually-hidden">About</h2>
	<p class="about__intro about__intro--role">
		Passionate about crafting user-focused experiences and driving strategy-led
		creative processes.
	</p>
	<p class="about__intro about__intro--job">
		Currently working at <Link {...employerLink}>{name}</Link>, {description}.
	</p>
</div>
<div class="about__grid">
	<div class="about__info about__info--experience">
		<h3 class="about__title">Years of experience</h3>
		<p class="about__content about__content--year">5+</p>
	</div>
	<div class="about__info about__info--expertise">
		<h3 class="about__title">Specialized in</h3>
		<ul class="about__list">
			<li class="about__content">
				Web <span class="about__highlight">development.</span>
			</li>
			<li class="about__content">
				Software <span class="about__highlight">engineering.</span>
			</li>
			<li class="about__content">
				UX/UI <span class="about__highlight">design.</span>
			</li>
		</ul>
	</div>
</div>
<div class="about__grid">
	<p class="about__intro about__intro--context">
		Versatile and detail-oriented self-taught programmer with prior experience
		in the architecture, research and design sectors.
	</p>
	<p class="about__intro about__intro--goal">
		Motivated to work on a team focused on good practices, continuous learning,
		feedback-driven culture and transparency.
	</p>
</div>

<style>
	.about__grid {
		@media (min-width: 1180px) {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-auto-flow: dense;
			margin-top: 3rem;
		}
	}

	.about__intro--role,
	.about__intro--context {
		grid-column: 1/7;
	}

	.about__intro--job,
	.about__intro--goal {
		grid-column: 8/13;
	}

	.about__info--experience {
		grid-column: 1/4;
		margin-top: clamp(0rem, 3rem - 48 * (100vw - 320px) / 360, 3rem);
	}

	.about__info--expertise {
		grid-column: 5/12;
	}

	.about__title {
		margin-top: 2rem;
		margin-bottom: 0;
		font-size: var(--text-l);
		font-family: var(--font-body);

		@media (min-width: 1180px) {
			margin-top: 0;
		}
	}

	.about__list {
		margin: 0 0 3rem 0;
	}

	.about__content {
		margin: 0;
		font-family: var(--font-title);
		font-size: var(--text-2xl);
		color: var(--color-accent);
	}

	.about__content--year {
		font-family: var(--font-body);
	}

	.about__highlight {
		font-family: var(--font-title-italic);
	}
</style>
