---
import Section from '@components/BaseSection.astro'
import Wrapper from '@components/BaseWrapper.astro'
import Card from '@components/Card.astro'
import { projects } from '@data/projects.json'
---

<Section id="projects">
	<Wrapper>
		<ul class="projects__list">
			{
				projects.map(({ id, title, text, tags, links }) => (
					<li class="projects__item">
						<Card id={id} title={title} text={text} tags={tags} links={links} />
					</li>
				))
			}
		</ul>
	</Wrapper>
</Section>

<style>
	.projects__item:first-child {
		border-top: 1px solid var(--color-border);
	}
</style>
