---
import Section from '@components/BaseSection.astro'
import Wrapper from '@components/BaseWrapper.astro'
import BaseCard from '@components/BaseCard.astro'
import ExperienceCard from '@components/ExperienceCard.astro'
import { experience } from '@data/experience.json'
---

<Section id="experience">
	<Wrapper>
		<h2 class="visually-hidden">Experience</h2>
		<ul class="experience__list">
			{
				experience.map(({ id, title, company, url, projects, tags, date }) => (
					<li class="experience__item">
						<BaseCard>
							<ExperienceCard
								id={id}
								title={title}
								company={company}
								url={url}
								projects={projects}
								tags={tags}
								date={date}
							/>
						</BaseCard>
					</li>
				))
			}
		</ul>
	</Wrapper>
</Section>

<style>
	.experience__item:first-child {
		border-top: 1px solid var(--color-border);
	}
</style>
