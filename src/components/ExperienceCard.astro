---
interface Props {
	id: number
	title: string
	company: string
	url?: string
	projects: Array<{
		id: number
		text: string
	}>
	tags: Array<{ id: number; text: string }>
	date: { start: string; end: string }
}
import Link from './Link.astro'
import Tag from './Tag.astro'

const { id, title, company, url, projects, tags, date } = Astro.props
---

<div class="experience-card">
	{id && <p class="experience-card__number">0{id}</p>}
	<div>
		<div class="experience-card__top">
			<h3 set:html={title} class="experience-card__title" />
			<span class="experience-card__dates"
				><time>{date.start}</time> - <time>{date.end}</time></span
			>
		</div>
		<div class="experience-card__company">
			<span class="experience-card__subtitle">
				{company === 'Freelance' ? 'as' : 'at'}</span
			>
			{
				url ? (
					<Link href={url} title={company} isExternalLink>
						<h4 class="experience-card__subtitle">{company}</h4>
					</Link>
				) : (
					<h4 class="experience-card__subtitle">{company}</h4>
				)
			}
		</div>
	</div>
	<ul class="experience-card__projects">
		{
			projects.map((project) => (
				<li class="experience-card__project">{project.text}</li>
			))
		}
	</ul>
	<ul class="experience-card__tags">
		{
			tags.map((tag) => (
				<li>
					<Tag text={tag.text} />
				</li>
			))
		}
	</ul>
</div>

<style>
	.experience-card {
		display: flex;
		flex-direction: column;
		gap: clamp(0.5rem, 0.5rem + 24 * (100vw - 320px) / 360, 2rem);
	}

	.experience-card__number {
		margin: 0;
		font-size: 1.5rem;
		font-family: var(--font-body-italic);
	}

	/* Title and dates on one line only on desktop: with wrapping instead, cards at the
	same width would differ (dates beside short titles, below long ones) */
	.experience-card__top {
		@media (min-width: 1180px) {
			display: flex;
			justify-content: space-between;
			align-items: flex-end;
			gap: 1rem;
		}
	}

	.experience-card__title {
		min-width: 0;
		margin: 0;
		overflow-wrap: break-word;
		font-family: var(--font-title);
		font-size: var(--text-xl);
		font-weight: 400;
		color: var(--color-accent);
	}

	/* The highlight comes from experience.json through set:html, so it isn't scoped */
	.experience-card__title :global(.experience-card__highlight) {
		font-family: var(--font-title-italic);
	}

	.experience-card__dates {
		font-size: var(--text-m);
	}

	.experience-card__company {
		display: flex;
		gap: 1rem;
	}

	.experience-card__subtitle {
		margin: 0 0 2rem 0;
		font-size: var(--text-m);
		font-weight: 400;
	}

	/* Keeps lines readable on wide screens */
	.experience-card__projects {
		@media (min-width: 1180px) {
			max-width: 70%;
		}
	}

	.experience-card__project:not(:last-of-type) {
		margin-bottom: clamp(1rem, 1rem + 16 * (100vw - 320px) / 860, 2rem);
	}

	.experience-card__tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: clamp(1rem, 1rem + 32 * (100vw - 320px) / 860, 3rem);
		margin-top: clamp(1rem, 1rem + 16 * (100vw - 320px) / 860, 2rem);
	}
</style>
