---
interface Props {
	id?: string
	class?: string
}

const { id, class: className } = Astro.props
---

<section id={id} class:list={['section', className]}>
	<slot />
</section>

<style>
	.section:not(:last-of-type) {
		margin-bottom: 3rem;
	}

	.section:not(:first-of-type) {
		margin-top: 3rem;
	}
</style>
