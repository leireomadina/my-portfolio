---
interface Props {
	id?: number
	title: string
	subtitle?: string
	text?: string
	tags: Array<{ id: number; text: string }>
	links?: Array<{
		href: string
		title: string
		isExternalLink?: boolean
		icon?: string
	}>
}

import Link from './Link.astro'
import Tag from './Tag.astro'
import ArrowIcon from '@assets/icons/arrow-diagonal-up-right.astro'
import GithubIcon from '@assets/icons/github.astro'

const { id, title, subtitle, text, tags, links } = Astro.props
---

<article class="card">
	<div class="card__inner">
		{id && <p class="card__number">0{id}</p>}
		<div class="card__top">
			<div>
				<h3 class="card__title">{title}</h3>
				{subtitle && <h4 class="card__subtitle">{subtitle}</h4>}
			</div>
			<ul class="card__list">
				{
					links &&
						links.map((link) => (
							<li>
								<Link
									href={link.href}
									title={link.title}
									class="card__link"
									isExternalLink
								>
									{link.icon === 'github' ? <GithubIcon /> : <ArrowIcon />}
								</Link>
							</li>
						))
				}
			</ul>
		</div>

		{text && <p class="card__text">{text}</p>}
		<ul class="card__list">
			{
				tags.map((tag) => (
					<li>
						<Tag text={tag.text} />
					</li>
				))
			}
		</ul>
	</div>
</article>

<style>
	.card {
		padding: 1.5rem 1rem 2rem 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.card__inner {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.card__number {
		margin: 0;
		font-family: var(--font-body-italic);
	}

	.card__top {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem;
	}

	/* The icons are separate components, so they need :global */
	.card :global(svg) {
		width: 32px;
	}

	.card__title,
	.card__text {
		margin: 0;
		font-weight: 400;
	}

	.card__title {
		min-width: 0;
		overflow-wrap: break-word;
		font-family: var(--font-title);
		font-size: 2rem;
	}

	.card__subtitle {
		margin: 0.4rem 0;
		font-size: 1.3rem;
		font-weight: 400;
	}

	.card__list {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}
</style>
