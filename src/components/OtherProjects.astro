---
import Section from '@components/BaseSection.astro'
import Wrapper from '@components/BaseWrapper.astro'
import Card from '@components/Card.astro'
import { projects } from '@data/otherProjects.json'
---

<Section>
	<Wrapper>
		<h2 class="other-projects__title">Other projects</h2>
		<ul>
			{
				projects.map(({ title, tags, links }) => (
					<li class="other-projects__item">
						<Card title={title} tags={tags} links={links} />
					</li>
				))
			}
		</ul>
	</Wrapper>
</Section>

<style>
	.other-projects__title {
		margin-top: 0;
		margin-bottom: 2rem;
		font-family: var(--font-title);
		font-size: 1.5rem;
	}

	.other-projects__item:not(:last-of-type) {
		margin-bottom: 1rem;
	}
</style>
