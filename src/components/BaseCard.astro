---
interface Props {
	class?: string
}

const { class: className } = Astro.props
---

<article class:list={['base-card', className]}>
	<slot />
</article>

<style>
	.base-card {
		padding: 2rem clamp(0rem, 24 * (100vw - 320px) / 360, 1.5rem) 2.5rem;
		border-bottom: 1px solid var(--color-border);
	}
</style>
