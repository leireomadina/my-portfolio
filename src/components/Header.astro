---
import ThemeToggler from './ThemeToggler.astro'
import Menu from './Menu.astro'
---

<header class="header">
	<div class="header__top">
		<h1 class="header__heading">
			<span class="header__subtitle">Leire Ordeñana</span>
			<span class="header__role">Front-end developer & UI/UX designer</span>
		</h1>
		<div class="header__menu">
			<Menu>
				<ThemeToggler />
			</Menu>
		</div>
	</div>
	<p class="header__title">
		<span class="header__headline">
			I build digital products with<br class="header__break" />{' '}
			<span class="header__highlight">intention</span>{' '}
			<span class="header__phrase">
				and{' '}
				<span class="header__highlight">care</span>
			</span>
		</span>
	</p>
</header>

<style>
	.header {
		padding: clamp(2rem, 3rem - 16 * (100vw - 320px) / 360, 3rem) 1rem 1rem;
	}

	/* Name and menu share one grid cell, so the menu sits on the name's line without a fixed height */
	.header__top {
		/* Size of the name and role text; the menu is centred on the name's line with it */
		--name-size: var(--text-xs);

		display: grid;
		grid-template-areas: 'top';
	}

	.header__heading {
		grid-area: top;
		margin: 0.67em 0 1rem;
		font-size: var(--name-size);
		line-height: 1.15;
	}

	.header__menu {
		grid-area: top;
		justify-self: end;
		display: flex;
		align-items: center;
		/* Same box as the name's line, so the menu is centred on it */
		height: calc(1.15 * var(--name-size));
		margin-top: calc(0.67 * var(--name-size));
	}

	.header__title {
		margin: 0;
		font-weight: bold;
		font-family: var(--font-title);
		/* 11vw up to 5rem (~730px), then slowly up to 6rem on very wide screens (from ~1780px).
		The floor is its size on a 280px screen */
		font-size: clamp(1.925rem, 11vw, clamp(5rem, 4.5vw, 6rem));
	}

	.header__subtitle {
		display: block;
		font-family: var(--font-title-italic);
	}

	.header__role {
		display: block;
		margin-top: 1.5em;
	}

	.header__headline {
		display: block;
		max-width: 12.5em;
	}

	/* Keeps "and care" on the same line */
	.header__phrase {
		white-space: nowrap;
	}

	/* Keeps the tagline at three lines on small phones, instead of leaving "products" alone */
	.header__break {
		display: none;

		@media (max-width: 480px) {
			display: inline;
		}
	}

	.header__highlight {
		font-family: var(--font-title-italic);
		color: var(--color-accent);
	}
</style>
