---
import ThemeToggler from './ThemeToggler.astro'
import Menu from './Menu.astro'
---

<header class="header">
	<div class="header__top">
		<h1 class="header__heading">
			<span class="header__subtitle">Leire Ordeñana</span>
			<span class="header__role">Front-end developer & UI/UX designer</span>
		</h1>
		<div class="header__menu">
			<Menu>
				<ThemeToggler />
			</Menu>
		</div>
	</div>
	<p class="header__title">
		<span class="header__headline">
			I build digital products{' '}
			<span class="header__headline--nowrap">
				with<br class="header__headline--break" />{' '}
				<span class="header__headline--highlighted">intention</span>
			</span>{' '}
			<span class="header__headline--nowrap">
				and{' '}
				<span class="header__headline--highlighted">care</span>
			</span>
		</span>
	</p>
</header>

<style lang="scss">
	.header {
		padding: fluid(48px, 32px, 320px, 680px) 1rem 1rem 1rem;

		// Name + role on the left, menu on the right of the name's line
		&__top {
			// Size of the name and role text; the menu is centred on the name's line with it
			--name-size: #{$fluid-small-text};

			display: grid;
			grid-template-areas: 'top';
		}

		&__heading {
			grid-area: top;
			margin: 0.67em 0 1rem;
			font-size: var(--name-size);
			line-height: 1.15;
		}

		&__menu {
			grid-area: top;
			justify-self: end;
			display: flex;
			align-items: center;
			// Same box as the name's line, so the menu is centred on it
			height: calc(1.15 * var(--name-size));
			margin-top: calc(0.67 * var(--name-size));
		}

		&__title {
			margin: 0;
			font-weight: bold;
			font-family: $font-title;
			// 11vw up to 5rem (~730px), then slowly up to 6rem on very wide screens (from ~1780px).
			// The floor is its size on a 280px screen
			font-size: clamp(1.925rem, 11vw, clamp(5rem, 4.5vw, 6rem));
		}

		&__subtitle {
			display: block;
			font-family: $font-title-italic;
		}

		&__role {
			display: block;
			margin-top: 1.5em;
		}

		&__headline {
			display: block;
			// 70vw on wide screens, but at least 52rem, so it fills the line on smaller ones
			max-width: max(70vw, 52rem);

			// Keeps "with intention" and "and care" on the same line
			&--nowrap {
				white-space: nowrap;
			}

			// Small phones only: line break after "with"
			&--break {
				display: none;

				@include only-small-mobile {
					display: inline;
				}
			}

			&--highlighted {
				font-family: $font-title-italic;
				color: $color-pink-dark;
			}
		}
	}
</style>
