---
import ThemeToggler from './ThemeToggler.astro'
import Menu from './Menu.astro'
---

<header class="header">
	<div class="header__container">
		<h1 class="header__subtitle">Leire Ordeñana</h1>
		<div class="header__container">
			<Menu />
			<ThemeToggler />
		</div>
	</div>
	<h2 class="header__role">Front-end developer & UI/UX designer</h2>
	<h3 class="header__title">
		<span class="header__headline">
			<span class="header__headline--block"
				>I build digital products with
			</span><span
				class="header__headline--highlighted header__tagline--italic"
			>
				&nbsp;intention</span
			> and<span class="header__headline--highlighted header__tagline--italic"
				>&nbsp;care</span
			>
		</span>
	</h3>
</header>

<style lang="scss">
	.header {
		position: relative;
		padding: 3rem 1rem 1rem 1rem;

		@include tablet {
			padding-top: 2rem;
		}

		&__container {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		&__title {
			margin: 0;
			font-family: $font-title;
			font-size: 11vw;

			@include tablet {
				font-size: 5rem;
			}

			@include desktop {
				font-size: clamp(5rem, 4.5vw, 6rem);
			}
		}

		&__subtitle {
			font-size: 1rem;
			font-family: $font-title-italic;

			@include desktop {
				font-size: 1.5vw;
			}
		}

		&__role {
			margin-bottom: 1rem;
			font-size: 1rem;

			@include desktop {
				font-size: 1.5vw;
			}
		}

		&__headline {
			display: block;
			width: 100%;

			@include desktop {
				width: 70vw;
			}

			&--block {
				@include only-small-mobile {
					display: block;
				}
			}

			&--highlighted {
				color: $color-pink-dark;
			}
		}

		&__tagline {
			&--italic {
				font-family: $font-title-italic;
			}
		}
	}
</style>
