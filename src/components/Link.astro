---
interface Props {
	href: string
	title: string
	class?: string
	isExternalLink?: boolean
}

const { href, title, isExternalLink, class: className } = Astro.props
---

<a
	href={href}
	title={title}
	class:list={['link', className]}
	target={isExternalLink ? '_blank' : '_self'}
	rel={isExternalLink ? 'noopener noreferrer' : null}
>
	<slot /></a
>

<style>
	.link,
	.link:visited {
		font-family: var(--font-body-regular);
		color: var(--color-link);
	}
</style>
